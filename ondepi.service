[Unit]
Description=OndePi - Headless audio live source streamer for AzuraCast
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
SupplementaryGroups=dialout audio
ExecStart=/usr/local/bin/ondepi

Restart=always
RestartSec=10

Nice=-5
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ondepi

[Install]
WantedBy=multi-user.target
